{
  "name": "baconfy/ui",
  "shadcn": {
    "preset": "b0",
    "components": "all",
    "template": "laravel",
    "pointer": true
  },
  "composer": {
    "require": [
      "laravel/ai",
      "laravel/reverb",
      "laravel/horizon",
      "baconfy/prompt",
      "intervention/image",
      "promptphp/intercept",
      "nunomaduro/essentials"
    ],
    "require-dev": [
      "baconfy/factory-payload"
    ]
  },
  "npm": {
    "dependencies": [
      "@laravel/echo-react",
      "pusher-js"
    ],
    "devDependencies": []
  },
  "remove": [
    "resources/js/components",
    "resources/js/layouts",
    "resources/js/pages",
    "resources/js/hooks/use-mobile.tsx",
    "components.json",
    "routes/web.php",
    "pnpm-workspace.yaml"
  ],
  "source": "files"
}